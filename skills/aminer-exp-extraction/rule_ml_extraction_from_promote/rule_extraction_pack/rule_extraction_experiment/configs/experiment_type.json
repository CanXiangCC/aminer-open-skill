{
  "experiment_id": "rule_extraction_experiment_type_v1",
  "field_name": "experiment_type",
  "field_type": "str",
  "description": "评估experiment_type字段规则提取vs gold标准的效果",

  "test_set": "dev_10",
  "gold_set": "full_text_glm5_2",

  "rule_module": "src.rule_extraction.rules.experiment_type",
  "rule_class": "ExperimentTypeRule",
  "rule_params": {
    "use_experiment_sections": true,
    "min_score": 0.05
  },

  "data_paths": {
    "gold_data_dir": "data/gold",
    "fixtures_dir": "data/fixtures",
    "output_dir": "rule_extraction_experiment/results"
  },

  "metrics": [
    "accuracy",
    "coverage",
    "extraction_rate",
    "classification_report",
    "statistics"
  ],

  "comparison_settings": {
    "fuzzy_matching": true,
    "include_partial_matches": true,
    "similarity_threshold": 0.7
  }
}