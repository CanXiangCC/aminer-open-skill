{
  "experiment_id": "rule_extraction_sample_size_v1",
  "field_name": "sample_size",
  "field_type": "int",
  "description": "评估sample_size字段规则提取vs gold标准的效果",

  "test_set": "dev_10",
  "gold_set": "full_text_glm5_2",

  "rule_module": "src.rule_extraction.rules.sample_size",
  "rule_class": "SampleSizeRule",
  "rule_params": {
    "section_filter": true,
    "min_confidence": 0.8,
    "max_candidates": 5
  },

  "data_paths": {
    "gold_data_dir": "data/gold",
    "fixtures_dir": "data/fixtures",
    "output_dir": "rule_extraction_experiment/results"
  },

  "metrics": [
    "accuracy",
    "coverage",
    "extraction_rate",
    "precision",
    "recall",
    "f1_score",
    "statistics"
  ],

  "comparison_settings": {
    "tolerance": 0,
    "include_partial_matches": false,
    "similarity_threshold": 0.9
  }
}